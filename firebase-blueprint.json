{
  "entities": {
    "Season": {
      "title": "Season",
      "description": "A season or team grouping.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the season (e.g. Fall 2026)."
        },
        "uid": {
          "type": "string",
          "description": "The ID of the user who owns this season."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the season was created."
        }
      },
      "required": ["name", "uid", "createdAt"]
    },
    "Player": {
      "title": "Player",
      "description": "A baseball player in the lineup.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The player's full name."
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The player's positions."
        },
        "battingOrder": {
          "type": "integer",
          "description": "The player's position in the batting lineup."
        },
        "jerseyNumber": {
          "type": "string",
          "description": "The player's jersey number."
        },
        "seasonId": {
          "type": "string",
          "description": "The ID of the season this player belongs to."
        },
        "uid": {
          "type": "string",
          "description": "The ID of the user who added the player."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the player was added."
        }
      },
      "required": ["name", "positions", "uid", "createdAt"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Team-level settings.",
      "type": "object",
      "properties": {
        "allowDesignatedHitter": {
          "type": "boolean",
          "description": "Whether to allow 'Designated Hitter' as a position."
        },
        "allowOutfieldTwiceInRow": {
          "type": "boolean",
          "description": "Whether to allow assigning the same player to an outfield position in consecutive innings."
        },
        "publicSchedule": {
          "type": "boolean",
          "description": "Whether to allow public access to the game schedule."
        },
        "activeSeasonId": {
          "type": "string",
          "description": "The ID of the season the user is currently viewing."
        },
        "uid": {
          "type": "string",
          "description": "The ID of the user who owns these settings."
        }
      },
      "required": ["uid"]
    },
    "Game": {
      "title": "Game",
      "description": "A scheduled baseball game or practice session.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name or title of the game/practice."
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time of the game."
        },
        "time": {
          "type": "string",
          "description": "Optional start time formatted string."
        },
        "duration": {
          "type": "integer",
          "description": "Duration in minutes."
        },
        "opponent": {
          "type": "string",
          "description": "Opponent team name."
        },
        "location": {
          "type": "string",
          "description": "Field or location name."
        },
        "isHome": {
          "type": "boolean",
          "description": "Whether this is a home game."
        },
        "seasonId": {
          "type": "string",
          "description": "The ID of the season this game belongs to."
        },
        "rsvps": {
          "type": "object",
          "description": "A map of player IDs to their RSVP status."
        },
        "battingOrder": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The ordered list of player IDs for the batting lineup."
        },
        "lineup": {
          "type": "object",
          "description": "A map of innings to positions to player IDs."
        },
        "isLocked": {
          "type": "boolean",
          "description": "Whether the game lineup and batting order are locked."
        },
        "lockedInnings": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "List of locked inning indexes."
        },
        "lockedPositions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of locked position keys."
        },
        "mode": {
          "type": "string",
          "enum": ["standard", "scrimmage"],
          "description": "Game mode."
        },
        "type": {
          "type": "string",
          "enum": ["game", "practice"],
          "description": "Event type."
        },
        "seriesId": {
          "type": "string",
          "description": "ID linking recurring series."
        },
        "practiceAgenda": {
          "type": "array",
          "description": "List of practice activities."
        },
        "practiceNotes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Practice notes."
        },
        "practiceNoteSections": {
          "type": "array",
          "description": "Structured sections of practice notes."
        },
        "numGroups": {
          "type": "integer",
          "description": "Number of practice stations or groups."
        },
        "battingOrderChecks": {
          "type": "object",
          "description": "Map of player IDs to checked status."
        },
        "uid": {
          "type": "string",
          "description": "The ID of the user who created the game."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the game was created."
        }
      },
      "required": ["date", "rsvps", "uid", "createdAt"]
    },
    "Drill": {
      "title": "Drill",
      "description": "A baseball practice drill.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Drill title."
        },
        "category": {
          "type": "string",
          "description": "Drill category."
        },
        "summary": {
          "type": "string",
          "description": "Short summary or objective."
        },
        "setup": {
          "type": "string",
          "description": "Equipment and field placement setup instructions."
        },
        "steps": {
          "type": "string",
          "description": "Step-by-step execution guide."
        },
        "notes": {
          "type": "string",
          "description": "Coaching tips and focus points."
        },
        "youtubeUrl": {
          "type": "string",
          "description": "YouTube video link for demonstration."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the drill was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the drill was last updated."
        }
      },
      "required": ["title", "createdAt"]
    },
    "GuideSection": {
      "title": "GuideSection",
      "description": "A section/category in the coaching guides library.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The title of the guide section."
        },
        "description": {
          "type": "string",
          "description": "Short summary of the section."
        },
        "order": {
          "type": "integer",
          "description": "Display order index."
        },
        "isArchived": {
          "type": "boolean",
          "description": "Whether this section is archived."
        },
        "color": {
          "type": "string",
          "description": "Color theme identifier."
        },
        "uid": {
          "type": "string",
          "description": "The ID of the coach who owns this section."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the section was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the section was last updated."
        }
      },
      "required": ["name", "uid", "createdAt"]
    },
    "GuideArticle": {
      "title": "GuideArticle",
      "description": "A deep-dive coaching guide article.",
      "type": "object",
      "properties": {
        "sectionId": {
          "type": "string",
          "description": "Parent section ID."
        },
        "title": {
          "type": "string",
          "description": "Article title."
        },
        "summary": {
          "type": "string",
          "description": "Quick coaching overview."
        },
        "content": {
          "type": "string",
          "description": "Full written markdown content."
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published"],
          "description": "Draft or published state."
        },
        "order": {
          "type": "integer",
          "description": "Display order."
        },
        "photos": {
          "type": "array",
          "description": "Attached photos."
        },
        "youtubeUrls": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Embedded YouTube URLs."
        },
        "drillIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Cross-linked Drill Library IDs."
        },
        "isArchived": {
          "type": "boolean",
          "description": "Whether this article is archived."
        },
        "lastEditedBy": {
          "type": "object",
          "description": "Information on the last editor."
        },
        "history": {
          "type": "array",
          "description": "Edit history snapshots."
        },
        "uid": {
          "type": "string",
          "description": "The ID of the user who owns this article."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the article was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the article was updated."
        }
      },
      "required": ["sectionId", "title", "content", "uid", "createdAt"]
    },
    "GuideChecklist": {
      "title": "GuideChecklist",
      "description": "A coaching skill checkpoint item within a section.",
      "type": "object",
      "properties": {
        "sectionId": {
          "type": "string",
          "description": "Parent section ID."
        },
        "title": {
          "type": "string",
          "description": "The skill item title."
        },
        "description": {
          "type": "string",
          "description": "Optional details/cues."
        },
        "category": {
          "type": "string",
          "description": "Sub-category group name."
        },
        "order": {
          "type": "integer",
          "description": "Display order."
        },
        "linkedArticleId": {
          "type": "string",
          "description": "Optional linked article ID."
        },
        "linkedDrillId": {
          "type": "string",
          "description": "Optional linked drill ID."
        },
        "isArchived": {
          "type": "boolean",
          "description": "Whether the item is archived."
        },
        "uid": {
          "type": "string",
          "description": "Owner user ID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When created."
        }
      },
      "required": ["sectionId", "title", "uid", "createdAt"]
    },
    "GuideProgress": {
      "title": "GuideProgress",
      "description": "Seasonal completion tracking for a checklist item.",
      "type": "object",
      "properties": {
        "checklistId": {
          "type": "string",
          "description": "Target checklist item ID."
        },
        "sectionId": {
          "type": "string",
          "description": "Parent section ID."
        },
        "seasonId": {
          "type": "string",
          "description": "Active season ID."
        },
        "isCompleted": {
          "type": "boolean",
          "description": "Whether this skill has been covered in this season."
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When marked completed."
        },
        "completedBy": {
          "type": "object",
          "description": "Who marked it completed."
        },
        "notes": {
          "type": "string",
          "description": "Optional practice notes on this skill."
        },
        "uid": {
          "type": "string",
          "description": "Owner user ID."
        }
      },
      "required": ["checklistId", "sectionId", "seasonId", "isCompleted", "uid"]
    }
  },
  "firestore": {
    "seasons/{seasonId}": {
      "schema": "Season",
      "description": "Collection of seasons or teams."
    },
    "players/{playerId}": {
      "schema": "Player",
      "description": "Collection of baseball players."
    },
    "settings/{userId}": {
      "schema": "Settings",
      "description": "Team-level settings for a user."
    },
    "games/{gameId}": {
      "schema": "Game",
      "description": "Collection of scheduled baseball games and practices."
    },
    "drills/{drillId}": {
      "schema": "Drill",
      "description": "Collection of shared team practice drills."
    },
    "guideSections/{sectionId}": {
      "schema": "GuideSection",
      "description": "Collection of coaching guide sections."
    },
    "guideArticles/{articleId}": {
      "schema": "GuideArticle",
      "description": "Collection of coaching guide articles."
    },
    "guideChecklists/{checklistId}": {
      "schema": "GuideChecklist",
      "description": "Collection of coaching guide checklist skill items."
    },
    "guideProgress/{progressId}": {
      "schema": "GuideProgress",
      "description": "Collection of season-specific checklist progress states."
    }
  }
}
